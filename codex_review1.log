 144: def logo_png(path: Path, kind='primary', dark=False):
 145:     if kind == 'icon':
 146:         size = (512, 512); mark = (150, 118, 230)
 147:     elif kind == 'secondary':
 148:         size = (900, 620); mark = (345, 70, 210)
 149:     elif kind == 'badge':
 150:         size = (720, 720); mark = (250, 150, 220)
 151:     else:
 152:         size = (1300, 380); mark = (95, 82, 182)
 153:     img = Image.new('RGBA', size, (0, 0, 0, 0))
 154:     d = ImageDraw.Draw(img)
 155:     ink = rgba(OFF_WHITE if dark else GRAPHITE, 255)
 156:     draw_el_mark(d, mark[0], mark[1], mark[2], dark=not dark)
 157:     if kind == 'badge':
 158:         d.ellipse([42, 42, size[0]-42, size[1]-42], outline=rgba(PETROL, 255), width=6)
 159:         text_center(d, (size[0]//2, 505), 'ELEMENTS', font(56, True), ink)
 160:         text_center(d, (size[0]//2, 585), 'LABS', font(56, True), ink)
 161:     elif kind == 'secondary':
 162:         text_center(d, (size[0]//2, 430), 'ELEMENTS', font(68, True), ink)
 163:         text_center(d, (size[0]//2, 515), 'LABS', font(68, True), ink)
 164:     elif kind == 'primary':
 165:         d.text((385, 112), 'ELEMENTS', font=font(92, True), fill=ink)
 166:         d.text((385, 220), 'LABS', font=font(92, True), fill=ink)
 167:     img.save(path)
