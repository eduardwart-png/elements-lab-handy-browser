 280: def draw_box(img, xy, product=None, scale=1.0):
 281:     d = ImageDraw.Draw(img)
 282:     x,y,w,h = xy
 283:     side = [(x+w*.76,y+20),(x+w,y+40),(x+w,y+h-18),(x+w*.76,y+h)]
 284:     front = [x,y,x+w*.78,y+h]
 285:     d.polygon(side, fill=(225,229,230,255), outline=(186,194,198,255))
 286:     d.rounded_rectangle(front, radius=16, fill=rgba(OFF_WHITE,255), outline=(192,199,203,255), width=2)
 287:     d.rectangle([x, y, x+w*.78, y+8], fill=rgba(PETROL,255))
 288:     draw_el_mark(d, x+30, y+34, 50*scale, dark=True)
 289:     d.text((x+96*scale,y+36), 'ELEMENTS LABS', font=font(18 if scale<=1 else 24, True), fill=rgba(GRAPHITE,255))
 290:     if product:
 291:         d.text((x+34,y+h*.47), product['name'], font=font(30 if scale<=1 else 38, True), fill=rgba(NEAR_BLACK,255))
 292:         d.text((x+34,y+h*.58), product['concentration'], font=font(21 if scale<=1 else 28, True), fill=rgba(PETROL,255))
 293:         d.text((x+34,y+h-54), product['batch'], font=font(13 if scale<=1 else 18, False, True), fill=rgba(MUTED,255))
 294:     d.line([x+28,y+h-75,x+w*.72,y+h-75], fill=rgba(LINE,255), width=2)
