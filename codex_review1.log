 560:     (ROOT / 'app.js').write_text(APP, encoding='utf-8')
 561:     (ROOT / 'index.html').write_text(build_html(PRODUCTS, inline=False), encoding='utf-8')
 562:     (ROOT / '_standalone.html').write_text(build_html(standalone_products(), inline=True), encoding='utf-8')
 563:     (ROOT / 'qa' / 'cdp_production_qa.js').write_text(QA_JS, encoding='utf-8')
