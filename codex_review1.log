  91: def add_noise(img: Image.Image, amount=9, alpha=18):
  92:     w, h = img.size
  93:     noise = Image.new('RGBA', (w, h), (0, 0, 0, 0))
  94:     px = noise.load()
  95:     for _ in range(int(w * h * amount / 9000)):
  96:         x = random.randrange(w); y = random.randrange(h)
  97:         v = random.randrange(255)
  98:         px[x, y] = (v, v, v, random.randrange(0, alpha))
  99:     return Image.alpha_composite(img.convert('RGBA'), noise)
