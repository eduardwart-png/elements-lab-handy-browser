 412: CSS = r'''
 413: :root{
 414:   --graphite:#2A2F36;--near-black:#0D1115;--off-white:#F7F7F8;--petrol:#0D5B6B;--ink:#172027;--muted:#66717B;--line:#D9DEE1;--panel:#FFFFFF;--soft:#EEF2F3;--radius:26px;--max:1220px;--shadow:0 28px 70px rgba(13,17,21,.13);--sans:"Space Grotesk","Segoe UI",Roboto,Arial,sans-serif;--mono:"Cascadia Mono","SFMono-Regular","Segoe UI Mono",monospace}
 415: *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--off-white);color:var(--ink);font-family:var(--sans);line-height:1.5;overflow-x:hidden}a{color:inherit;text-decoration:none}button,input,select{font:inherit}.site-header{position:sticky;top:0;z-index:40;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:20px;max-width:var(--max);margin:0 auto;padding:18px 22px;background:rgba(247,247,248,.91);backdrop-filter:blur(18px);border-bottom:1px solid rgba(42,47,54,.12)}.brand{display:flex;align-items:center;gap:13px;font-weight:850;letter-spacing:.13em}.brand img{width:220px;height:auto;display:block}.brand .brand-mobile{display:none}.main-nav{display:flex;gap:24px;justify-content:center;color:#55606A;font-size:14px}.main-nav a{padding:8px 0;border-bottom:1px solid transparent}.main-nav a:hover,.main-nav a.active{color:var(--near-black);border-color:var(--petrol)}.header-actions{display:flex;gap:10px;align-items:center}.menu-toggle{display:none}.secondary-btn,.ghost-btn,.menu-toggle,.search-open{border:1px solid var(--line);background:rgba(255,255,255,.62);color:var(--graphite);border-radius:999px;padding:11px 16px;cursor:pointer;transition:.2s ease}.primary-btn,.cart-link{border:1px solid var(--petrol);background:var(--near-black);color:white;border-radius:999px;padding:11px 17px;cursor:pointer;box-shadow:0 12px 24px rgba(13,17,21,.12);transition:.2s ease}.primary-btn:hover,.secondary-btn:hover,.cart-link:hover,.ghost-btn:hover{transform:translateY(-1px)}.cart-link span{display:inline-grid;place-items:center;min-width:22px;height:22px;margin-left:6px;background:var(--petrol);color:white;border-radius:50%;font:800 12px var(--mono)}.section{max-width:var(--max);margin:0 auto;padding:84px 22px}.hero{min-height:calc(100vh - 82px);display:grid;grid-template-columns:.92fr 1.08fr;gap:58px;align-items:center}.eyebrow{font:800 12px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--petrol);margin-bottom:16px}.hero h1,.page-title{font-size:clamp(45px,5.4vw,84px);line-height:1.02;letter-spacing:-.045em;margin:0 0 24px;color:var(--near-black)}.hero h1 span,.page-title span{color:var(--petrol)}.lead{font-size:clamp(17px,1.5vw,21px);color:var(--muted);max-width:600px;margin:0 0 30px}.cta-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:22px}.trust-matrix{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:30px}.trust-matrix div,.metric-card{padding:17px;background:rgba(255,255,255,.72);border:1px solid var(--line);border-radius:18px}.trust-matrix strong,.metric-card strong{display:block;font-size:14px;color:var(--near-black);margin-bottom:5px}.trust-matrix span,.metric-card span{font-size:12px;color:var(--muted)}.hero-photo,.wide-photo{position:relative;background:linear-gradient(145deg,#fff,#EEF2F3);border:1px solid var(--line);border-radius:34px;box-shadow:var(--shadow);overflow:hidden}.hero-photo img,.wide-photo img{display:block;width:100%;height:auto}.photo-caption{position:absolute;left:22px;bottom:22px;padding:12px 15px;border-radius:14px;background:rgba(255,255,255,.82);border:1px solid rgba(217,222,225,.9);backdrop-filter:blur(14px);font:800 11px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--graphite)}.section-head{margin-bottom:34px;display:flex;align-items:end;justify-content:space-between;gap:24px}.section-head h2{font-size:clamp(32px,3.5vw,52px);line-height:1.05;letter-spacing:-.032em;margin:0;color:var(--near-black)}.section-head p{max-width:560px;color:var(--muted);margin:0}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(285px,1fr));gap:24px}.product-card{background:var(--panel);border:1px solid var(--line);border-radius:28px;padding:18px;display:flex;flex-direction:column;position:relative;overflow:hidden;min-height:510px;box-shadow:0 18px 44px rgba(13,17,21,.08)}.product-card:before{content:"";position:absolute;inset:0 0 auto;height:6px;background:linear-gradient(90deg,var(--graphite),var(--petrol));opacity:.95}.card-top{display:flex;justify-content:space-between;font:800 10px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin:8px 0 8px}.product-img-wrap{display:grid;place-items:center;background:linear-gradient(180deg,#F8FAFA,#ECEFF1);border:1px solid #E1E6E8;border-radius:23px;min-height:250px;margin-bottom:18px;overflow:hidden}.product-img-wrap img{width:82%;height:auto;filter:drop-shadow(0 18px 24px rgba(13,17,21,.14))}.product-card h3{margin:0 0 7px;font-size:22px;letter-spacing:-.018em;color:var(--near-black)}.compound-meta{font-size:13px;color:var(--muted);line-height:1.58}.price-row{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:17px}.price{font:850 24px/1 var(--sans);letter-spacing:-.02em}.status{font:800 11px var(--mono);color:var(--petrol);text-transform:uppercase;letter-spacing:.07em}.card-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}.card-actions .secondary-btn,.card-actions .primary-btn{text-align:center;padding:12px 10px;font-size:13px}.quality-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:28px;align-items:start}.process{counter-reset:step;list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px}.process li{counter-increment:step;position:relative;padding:18px 18px 18px 58px;background:#fff;border:1px solid var(--line);border-radius:18px}.process li:before{content:counter(step,decimal-leading-zero);position:absolute;left:17px;top:20px;font:850 14px var(--mono);color:var(--petrol)}.process strong{display:block;margin-bottom:4px}.coa-preview,.batch-panel,.cart-panel,.partner-panel{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 15px 42px rgba(13,17,21,.07)}.report{position:relative;background:#FCFCFD;color:var(--near-black);border:1px solid #DDE2E5;border-radius:18px;padding:24px}.report-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:18px}.report-grid div{padding:12px;border:1px solid #E1E5E8;border-radius:12px;background:white}.report-grid span{display:block;font:800 10px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}.report-grid strong{font-size:14px}.detail-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:36px;align-items:start}.gallery{display:grid;gap:16px}.gallery-main{background:linear-gradient(180deg,#fff,#EEF2F3);border:1px solid var(--line);border-radius:32px;overflow:hidden;box-shadow:var(--shadow)}.gallery-main img{display:block;width:100%;height:auto}.thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.thumbs img{width:100%;border:1px solid var(--line);border-radius:18px;background:#fff}.purchase{position:sticky;top:100px;background:#fff;border:1px solid var(--line);border-radius:32px;padding:30px;box-shadow:0 20px 46px rgba(13,17,21,.09)}.purchase h1{font-size:clamp(38px,4vw,58px);line-height:1.02;letter-spacing:-.04em;margin:0 0 15px;color:var(--near-black)}.spec-list{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin:24px 0}.spec-list div{padding:14px;background:#F6F8F8;border:1px solid var(--line);border-radius:14px}.spec-list span{display:block;font:800 10px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px}.spec-list strong{font-size:16px}.filters{display:grid;grid-template-columns:1.5fr .8fr .8fr;gap:12px;margin-bottom:24px}.filters input,.filters select,.batch-panel input{padding:13px 15px;background:#fff;border:1px solid var(--line);border-radius:14px;color:var(--ink)}.batch-panel input{width:100%;margin-bottom:16px}.qr{width:128px;height:128px;border-radius:12px;background:#fff;padding:7px;display:block;margin-top:18px;border:1px solid var(--line)}.cart-line{display:grid;grid-template-columns:1.2fr .7fr .7fr auto;gap:16px;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)}.qty{display:flex;gap:7px;align-items:center}.qty button{width:32px;height:32px;border-radius:50%;border:1px solid var(--line);background:#fff}.total{font:850 30px/1 var(--sans);text-align:right;margin:22px 0}.hidden{display:none}.footer{max-width:var(--max);margin:0 auto;padding:62px 22px 44px;display:grid;grid-template-columns:2fr 1.3fr 1.2fr;gap:28px;color:var(--muted);font-size:13px;border-top:1px solid var(--line)}.footer strong{color:var(--near-black)}.footer a{display:block;color:var(--muted);margin-bottom:8px}.research-only{grid-column:1/-1;text-align:center;font:800 11px var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding-top:18px;border-top:1px solid var(--line)}.faq-list{display:flex;flex-direction:column;gap:14px}.faq-list details{background:#fff;border:1px solid var(--line);border-radius:18px;padding:17px}.faq-list summary{font-weight:750;cursor:pointer}.legal{max-width:820px}.family-section .wide-photo{margin-top:10px}.brand-story{display:grid;grid-template-columns:.9fr 1.1fr;gap:32px;align-items:center}.brand-story img{width:100%;border-radius:30px;border:1px solid var(--line);box-shadow:var(--shadow)}.internal-badge{display:inline-block;background:#F2C94C;color:#101418;font:850 11px var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:6px 12px;border-radius:8px}.partner-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}.kpi{padding:20px;background:#F6F8F8;border:1px solid var(--line);border-radius:16px}.kpi span{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}.kpi strong{display:block;font-size:26px;margin:8px 0 4px}.partner-table{width:100%;border-collapse:collapse;font-size:14px}.partner-table th,.partner-table td{padding:12px 10px;text-align:left;border-bottom:1px solid var(--line)}.partner-table th{font:800 11px var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}#toast{position:fixed;bottom:22px;right:22px;z-index:60;background:var(--near-black);color:white;border:1px solid rgba(255,255,255,.12);border-radius:13px;padding:12px 18px;font-size:13px;box-shadow:var(--shadow);opacity:0;transform:translateY(10px);transition:opacity .25s,transform .25s;pointer-events:none}#toast.show-toast{opacity:1;transform:translateY(0)}
