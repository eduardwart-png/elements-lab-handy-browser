 503: def build_html(products, inline=False):
 504:     icon = data_url(LOGOS / 'el-icon-light.svg')
 505:     logo = data_url(LOGOS / 'el-primary-light.svg') if inline else 'assets/logos/el-primary-light.svg'
 506:     icon_logo = data_url(LOGOS / 'el-icon-light.svg') if inline else 'assets/logos/el-icon-light.svg'
 507:     fonts_css = font_face_css(inline)
 508:     pdata = json.dumps(products, ensure_ascii=False, separators=(',', ':'))
 509:     css_part = f'<style>{fonts_css}{CSS}</style>' if inline else f'<style>{fonts_css}</style><link rel="stylesheet" href="styles.css" />'
 510:     js_part = f'<script>{APP}</script>' if inline else '<script src="app.js"></script>'
 511:     return dedent(f'''<!doctype html>
 512: <html lang="de">
 513: <head>
 514:   <meta charset="utf-8" />
 515:   <meta name="viewport" content="width=device-width, initial-scale=1" />
 516:   <title>ELEMENTS LABS ƒ?" Premium Research Commerce</title>
 517:   <meta name="description" content="ELEMENTS LABS: Premium research product catalog with batch lookup, analysis structure and market-ready packaging direction." />
 518:   <link rel="icon" href="{icon}" />
 519:   {css_part}
 520: </head>
 521: <body>
 522:   <header class="site-header" id="top">
 523:     <a class="brand" href="#home" aria-label="ELEMENTS LABS Home"><img class="brand-desktop" src="{logo}" alt="ELEMENTS LABS"><img class="brand-mobile" src="{icon_logo}" alt="ELEMENTS LABS"></a>
 524:     <button class="menu-toggle" id="menuToggle" aria-expanded="false" aria-controls="mainNav">Menu</button>
 525:     <nav id="mainNav" class="main-nav" aria-label="Hauptnavigation">
 526:       <a href="#products">Products</a><a href="#quality">Quality</a><a href="#batch-lookup">Batch Lookup</a><a href="#about">About</a><a href="#faq">FAQ</a>
 527:     </nav>
 528:     <div class="header-actions"><button class="search-open" data-action="focus-search">Search</button><a class="cart-link" href="#cart">Cart <span id="cartCount">0</span></a></div>
 529:   </header>
 530:   <main id="app" tabindex="-1"></main>
 531:   <script id="productData" type="application/json">{pdata}</script>
 532:   {js_part}
 533:   <footer class="footer">
 534:     <div><strong>ELEMENTS LABS</strong><p>Premium research commerce structure with consistent product photography, packaging, batch IDs and analysis access.</p></div>
 535:     <div><a href="#legal-impressum">Impressum</a><a href="#legal-datenschutz">Datenschutz</a><a href="#contact">Support</a></div>
 536:     <div><strong>Research Notice</strong><p>Not for human consumption. No therapeutic, diagnostic, veterinary or dosing claims.</p></div>
 537:     <div class="research-only">Research Use Only ¶ú No Human Consumption ¶ú No Medical Claims</div>
 538:   </footer>
 539:   <div id="toast" role="status" aria-live="polite"></div>
 540: </body>
 541: </html>
 542: ''')
