 383: def data_url(path: Path) -> str:
 384:     ext = path.suffix.lower().lstrip('.')
 385:     mime = {'svg': 'image/svg+xml', 'woff2': 'font/woff2', 'woff': 'font/woff'}.get(ext, f'image/{"jpeg" if ext in ["jpg","jpeg"] else ext}')
 386:     return f'data:{mime};base64,' + base64.b64encode(path.read_bytes()).decode('ascii')
 387: 
