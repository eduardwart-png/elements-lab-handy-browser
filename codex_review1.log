  79: def linear_gradient(size, top, bottom):
  80:     w, h = size
  81:     img = Image.new('RGBA', size)
  82:     draw = ImageDraw.Draw(img)
  83:     t = rgb(top); b = rgb(bottom)
  84:     for y in range(h):
  85:         k = y / max(1, h - 1)
  86:         col = tuple(int(t[i] * (1 - k) + b[i] * k) for i in range(3)) + (255,)
  87:         draw.line([(0, y), (w, y)], fill=col)
  88:     return img
