 495: public_text = re.sub(r'<script\b.*?</script>', '', html, flags=re.I|re.S)
 496: if re.search(r'\b(DEMO|SAMPLE|TEST|PLACEHOLDER|MOCKUP|PROTOTYPE)\b', public_text, re.I): fail.append('banned public marker remains in HTML shell')
