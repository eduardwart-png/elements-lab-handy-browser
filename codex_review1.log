 417: @media(max-width:960px){.site-header{grid-template-columns:auto auto auto;gap:10px}.menu-toggle{display:block;margin-left:auto}.main-nav{position:absolute;left:14px;right:14px;top:74px;display:none;flex-direction:column;justify-content:flex-start;background:#fff;border:1px solid var(--line);border-radius:20px;padding:16px;box-shadow:var(--shadow)}.main-nav.open{display:flex}.search-open{display:none}.hero,.quality-grid,.detail-layout,.brand-story{grid-template-columns:1fr}.hero{min-height:auto;padding-top:48px}.cards{grid-template-columns:1fr 1fr}.trust-matrix{grid-template-columns:1fr 1fr}.filters{grid-template-columns:1fr}.footer{grid-template-columns:1fr}.cart-line{grid-template-columns:1fr;align-items:start}.total{text-align:left}.section{padding:60px 18px}.section-head{display:block}.purchase{position:relative;top:0}.spec-list{grid-template-columns:1fr 1fr}}
 418: @media(max-width:540px){.site-header{padding:12px 12px}.brand .brand-desktop{display:none}.brand .brand-mobile{display:block;width:40px;height:40px}.cart-link,.primary-btn,.secondary-btn,.ghost-btn,.menu-toggle{padding:10px 12px}.hero h1,.page-title{font-size:42px}.section{padding:48px 14px}.cards,.trust-matrix,.report-grid,.thumbs,.spec-list{grid-template-columns:1fr}.hero-photo,.wide-photo,.gallery-main{border-radius:24px}.photo-caption{left:12px;bottom:12px;font-size:9px}.product-card{min-height:500px}.product-img-wrap{min-height:240px}.qr{width:96px;height:96px}.header-actions{gap:6px}.main-nav{top:62px}.card-actions{grid-template-columns:1fr}.footer{padding-bottom:32px}}
