 186: def vial_png(product, w=900, h=1100, transparent=True, large_label=False):
 187:     random.seed(product['id'])
 188:     img = Image.new('RGBA', (w, h), (0, 0, 0, 0) if transparent else rgba(OFF_WHITE, 255))
 189:     d = ImageDraw.Draw(img)
 190:     cx = w // 2
 191:     body_w = int(w * .27)
 192:     body_h = int(h * .66)
 193:     top = int(h * .19)
 194:     left = cx - body_w // 2
 195:     right = cx + body_w // 2
 196:     bottom = top + body_h
 197: 
 198:     # compact grounded contact shadow, not a floating ellipse
 199:     shadow = Image.new('RGBA', (w, h), (0,0,0,0))
 200:     sd = ImageDraw.Draw(shadow)
 201:     sd.ellipse([left-58, bottom-18, right+58, bottom+28], fill=(13,17,21,44))
 202:     sd.ellipse([left+20, bottom-7, right-20, bottom+13], fill=(13,17,21,62))
 203:     shadow = shadow.filter(ImageFilter.GaussianBlur(13))
 204:     img.alpha_composite(shadow)
 205: 
 206:     # body silhouette with shoulders, thick edge, glass depth
 207:     glass = Image.new('RGBA', (w, h), (0,0,0,0))
 208:     gd = ImageDraw.Draw(glass)
 209:     body_points = [(left+22, top+52), (left+48, top+8), (right-48, top+8), (right-22, top+52), (right-8, bottom-70), (right-38, bottom-12), (left+38, bottom-12), (left+8, bottom-70)]
 210:     gd.polygon(body_points, fill=(246,251,252,42))
 211:     gd.line(body_points + [body_points[0]], fill=(139,158,168,82), width=3, joint='curve')
 212:     gd.rounded_rectangle([left+12, top+68, right-12, bottom-22], radius=body_w//2-18, outline=(255,255,255,116), width=3)
 213:     gd.rounded_rectangle([left+body_w*.12, top+42, left+body_w*.22, bottom-90], radius=30, fill=(255,255,255,78))
 214:     gd.rounded_rectangle([right-body_w*.20, top+86, right-body_w*.13, bottom-106], radius=22, fill=(13,91,107,34))
 215:     gd.line([left+34, top+110, left+30, bottom-110], fill=(51,68,79,34), width=2)
 216:     gd.line([right-34, top+108, right-30, bottom-112], fill=(51,68,79,38), width=2)
 217:     gd.ellipse([left+35, bottom-56, right-35, bottom-13], outline=(86,101,112,82), width=3)
 218:     gd.ellipse([left+52, bottom-42, right-52, bottom-22], fill=(226,235,238,34))
 219:     for _ in range(46):
 220:         x = random.randint(left+16, right-16); y = random.randint(top+42, bottom-92)
 221:         gd.line([x, y, x+random.randint(-5,5), y+random.randint(12,36)], fill=(255,255,255,random.randint(10,30)), width=1)
 222:     img.alpha_composite(glass)
 223: 
 224:     # neck, rubber stopper and ribbed aluminium crimp cap
 225:     cap_w = int(body_w * .72)
 226:     cap_left = cx - cap_w//2
 227:     cap_right = cx + cap_w//2
 228:     neck_top = top - 48
 229:     d.rounded_rectangle([cap_left+18, neck_top+30, cap_right-18, top+42], radius=14, fill=(224,231,234,98), outline=(255,255,255,150), width=2)
 230:     d.ellipse([cap_left+18, top+27, cap_right-18, top+50], fill=(205,215,220,88), outline=(255,255,255,108), width=2)
 231:     cap_grad = Image.new('RGBA', (cap_w, 56), (0,0,0,0))
 232:     cd = ImageDraw.Draw(cap_grad)
 233:     for yy in range(56):
 234:         k = yy/55
 235:         base = int(62*(1-k)+29*k)
 236:         cd.line([(0,yy),(cap_w,yy)], fill=(base,base+5,base+9,255))
 237:     cd.rounded_rectangle([0,0,cap_w-1,55], radius=11, outline=(14,17,20,255), width=2)
 238:     for x in range(7, cap_w-6, 10):
 239:         cd.line([x,7,x-2,49], fill=(120,130,136,145), width=2)
 240:     cd.rounded_rectangle([cap_w*.23, 10, cap_w*.77, 27], radius=6, fill=(13,17,21,245))
 241:     img.alpha_composite(cap_grad, (cap_left, neck_top))
 242: 
 243:     # label texture and exact label system, intentionally generated by text layer
 244:     lab_w = int(body_w * .88)
 245:     lab_h = int(body_h * (.44 if large_label else .38))
 246:     lab_left = cx - lab_w//2
 247:     lab_top = top + int(body_h * .265)
 248:     label = Image.new('RGBA', (lab_w, lab_h), rgba(OFF_WHITE, 252))
 249:     label = add_noise(label, amount=7, alpha=13)
 250:     ld = ImageDraw.Draw(label)
 251:     ld.rounded_rectangle([0,0,lab_w-1,lab_h-1], radius=7, outline=(204,211,215,255), width=2)
 252:     ld.rectangle([0,0,lab_w,8], fill=rgba(PETROL, 255))
 253:     draw_el_mark(ld, 18, 21, 39, dark=True)
 254:     ld.text((76, 22), 'ELEMENTS LABS', font=font(16, True), fill=rgba(GRAPHITE,255))
 255:     ld.text((76, 45), product['code'], font=font(11, False, True), fill=rgba(MUTED,255))
 256:     ld.line([16, 78, lab_w-16, 78], fill=rgba(LINE,255), width=2)
 257:     name_f = font(31 if len(product['name']) < 12 else 23, True)
 258:     ld.text((lab_w//2, 112), product['name'], font=name_f, fill=rgba(NEAR_BLACK,255), anchor='mm')
 259:     ld.text((lab_w//2, 149), product['concentration'], font=font(22, True), fill=rgba(PETROL,255), anchor='mm')
 260:     ld.line([16, lab_h-78, lab_w-16, lab_h-78], fill=rgba(LINE,255), width=1)
 261:     ld.text((16, lab_h-64), 'Research Use Only', font=font(12, True), fill=rgba(GRAPHITE,255))
 262:     ld.text((16, lab_h-42), product['batch'], font=font(11, False, True), fill=rgba(MUTED,255))
 263:     paste_qr(label, product, (lab_w-66, lab_h-68, lab_w-17, lab_h-19))
 264:     ld.text((lab_w-67, lab_h-17), 'Analysis', font=font(9, False, True), fill=rgba(MUTED,255))
 265:     # Subtle cylindrical light falloff over label edges
 266:     mask = Image.new('L', (lab_w, lab_h), 0)
 267:     md = ImageDraw.Draw(mask)
 268:     md.rounded_rectangle([0,0,lab_w-1,lab_h-1], radius=7, fill=255)
 269:     edge = Image.new('RGBA', (lab_w, lab_h), (0,0,0,0))
 270:     ed = ImageDraw.Draw(edge)
 271:     ed.rectangle([0,0,10,lab_h], fill=(0,0,0,18))
 272:     ed.rectangle([lab_w-10,0,lab_w,lab_h], fill=(0,0,0,14))
 273:     label = Image.alpha_composite(label, edge)
 274:     img.alpha_composite(label, (lab_left, lab_top))
 275:     d.rounded_rectangle([lab_left, lab_top, lab_left+lab_w, lab_top+lab_h], radius=7, outline=(255,255,255,88), width=1)
 276:     # Foreground glass reflection across label/body
 277:     d.rounded_rectangle([left+body_w*.18, top+30, left+body_w*.25, bottom-70], radius=26, fill=(255,255,255,32))
 278:     return img
