    2: const products = JSON.parse(document.getElementById('productData').textContent);
    3: window.__ELEMENTS_PRODUCTS__ = products;
    4: const money = v => Number(String(v).replace('ƒ'ª','').replace('.','').replace(',','.').trim());
    5: const fmt = n => n.toLocaleString('de-DE',{style:'currency',currency:'EUR'});
    6: let cart = JSON.parse(localStorage.getItem('elementsCart') || '{}');
    7: const app = document.getElementById('app');
    8: function saveCart(){localStorage.setItem('elementsCart', JSON.stringify(cart)); updateCartCount();}
    9: function updateCartCount(){document.getElementById('cartCount').textContent = Object.values(cart).reduce((a,b)=>a+b,0)}
   10: function toast(t){const el=document.getElementById('toast');el.textContent=t;el.classList.add('show-toast');setTimeout(()=>el.classList.remove('show-toast'),1500)}
   11: function addToCart(id,qty=1){cart[id]=(cart[id]||0)+qty;saveCart();toast('Zum Warenkorb hinzugefÇ¬gt');}
   12: function removeFromCart(id){delete cart[id];saveCart();render()}
   13: function setQty(id,qty){if(qty<=0) delete cart[id]; else cart[id]=qty;saveCart();render()}
   14: function pById(id){return products.find(p=>p.id===id)}
   15: function pByBatch(b){return products.find(p=>p.batch.toLowerCase()===String(b||'').toLowerCase())}
   16: function productCard(p){return `<article class="product-card ${p.featured?'featured':''}" data-product-card data-id="${p.id}"><div class="card-top"><span>${p.num} ¶ú ${p.category}</span><span>${p.batch}</span></div><a class="product-img-wrap" href="#product=${p.id}" aria-label="${p.name} Çôffnen"><img src="${p.image}" alt="${p.name} ${p.concentration} Elements Labs Vial"></a><h3>${p.name}</h3><div class="compound-meta">${p.concentration} ¶ú ${p.code}</div><div class="price-row"><span class="price">${p.price}</span><span class="status">Batch-linked</span></div><p class="compound-meta">${p.desc}</p><div class="card-actions"><a class="secondary-btn" href="#product=${p.id}">Details</a><button class="primary-btn" data-add="${p.id}">Add to Cart</button></div></article>`}
   17: function report(p){return `<div class="report" data-coa="${p.id}"><div class="eyebrow">Analysis structure</div><h3>Batch Documentation ƒ?" ${p.name}</h3><p class="compound-meta">Dieses Panel bildet die spÇÏtere Berichtstruktur ab. Werte werden erst nach echter externer Analyse verÇôffentlicht.</p><div class="report-grid"><div><span>Compound</span><strong>${p.name}</strong></div><div><span>Batch</span><strong>${p.batch}</strong></div><div><span>COA</span><strong>Nicht verÇôffentlicht</strong></div><div><span>Lab</span><strong>Nicht verÇôffentlicht</strong></div><div><span>Date</span><strong>Nicht verÇôffentlicht</strong></div><div><span>Identity</span><strong>Ausstehend</strong></div><div><span>Purity</span><strong>Ausstehend</strong></div><div><span>Method</span><strong>Ausstehend</strong></div></div></div>`}
   18: function home(){const featured=products.filter(p=>p.featured).slice(0,6);return `<section class="section hero" id="home-hero"><div><div class="eyebrow">European Premium Research Brand</div><h1>ELEMENTS LABS. <span>Research Commerce</span> mit realer Produktdisziplin.</h1><p class="lead">Eine helle, technische Premium-Marke fÇ¬r strukturierte Research-Ware: klare Vials, konsistente Verpackung, Batch-Traceability und Commerce ohne medizinische Claims.</p><div class="cta-row"><a class="primary-btn" href="#products">Produkte entdecken</a><a class="secondary-btn" href="#batch-lookup">Batch prÇ¬fen</a></div><div class="trust-matrix"><div><strong>13 Produkte</strong><span>vollstÇÏndiges Startportfolio</span></div><div><strong>Ein Labelsystem</strong><span>einheitliche Verpackungslinie</span></div><div><strong>Batch-Struktur</strong><span>Produkt, Code und Charge verbunden</span></div><div><strong>Research Only</strong><span>keine Human-Use-Kommunikation</span></div></div></div><figure class="hero-photo"><img src="assets/scenes/hero-studio-scene.png" alt="ELEMENTS LABS Produktfotografie mit Vials und Verpackung"><figcaption class="photo-caption">macro studio ¶ú graphite / off-white / petrol</figcaption></figure></section><section class="section"><div class="section-head"><div><div class="eyebrow">Featured Products</div><h2>Portfolio mit einheitlicher Produktlogik.</h2></div><p>Jede Karte nutzt dieselbe Glasform, dasselbe Labelraster und dieselbe Informationshierarchie.</p></div><div class="cards">${featured.map(productCard).join('')}</div></section>${qualityBlock(false)}<section class="section family-section"><div class="section-head"><div><div class="eyebrow">Product Family</div><h2>13 Produkte, eine glaubwÇ¬rdige Fertigungslinie.</h2></div><p>Keine zufÇÏlligen Farben, keine Clipart-Logos, keine wechselnden Glasformen: Die Vials wirken wie eine zusammenhÇÏngende Markenproduktion.</p></div><figure class="wide-photo"><img src="assets/scenes/group-product-shot.png" alt="ELEMENTS LABS Gruppe mit 13 Research Vials"><figcaption class="photo-caption">13/13 product family</figcaption></figure></section><section class="section brand-story"><div><div class="eyebrow">Packaging Direction</div><h2>Off-White Karton, Graphite-Typografie, Petrol-Akzent.</h2><p class="lead">Die Verpackung ist bewusst nÇÏher an Diagnostics, Labortechnik und Premium-Kosmetik als an Supplements oder Fitness-Commerce.</p><div class="cta-row"><a class="primary-btn" href="#quality">Quality System</a><a class="secondary-btn" href="#about">Brand Story</a></div></div><img src="assets/scenes/packaging-shot.png" alt="ELEMENTS LABS Premium Packaging mit Vial"></section><section class="section"><div class="section-head"><div><div class="eyebrow">FAQ / Support</div><h2>Klarheit vor Conversion-Hype.</h2></div><p>Die Seite bleibt commercefÇÏhig, ohne Laborwerte, Zertifikate oder Unternehmensdetails zu erfinden.</p></div><div class="faq-list"><details open><summary>WofÇ¬r ist das Portfolio vorgesehen?</summary><p>FÇ¬r Research-Kontexte. Keine Einnahme, keine Anwendung, keine therapeutische oder diagnostische Kommunikation.</p></details><details><summary>Was zeigt die Batch-Suche?</summary><p>Sie verbindet Produkt, Charge, Code und vorbereitete Analysefelder. Reale Werte werden erst nach echter PrÇ¬fung ergÇÏnzt.</p></details><details><summary>Warum diese Bildwelt?</summary><p>Makro-Studiofotografie, klare Materialien und ein reproduzierbares Labelsystem machen die Marke glaubwÇ¬rdig und skalierbar.</p></details></div></section>`}
   19: function productsPage(){return `<section class="section"><div class="section-head"><div><div class="eyebrow">Catalog</div><h1 class="page-title">13 Research <span>Products.</span></h1></div><p>Alle verbindlichen Produkte mit korrekter Konzentration, Preis, Produktcode und Batch-ID.</p></div><div class="filters"><input id="searchInput" placeholder="Search compound, code or batch" aria-label="Produkt suchen"><select id="categoryFilter"><option value="">Alle Kategorien</option>${[...new Set(products.map(p=>p.category))].map(c=>`<option>${c}</option>`).join('')}</select><select id="sortFilter"><option value="featured">Featured zuerst</option><option value="price-asc">Preis aufsteigend</option><option value="price-desc">Preis absteigend</option></select></div><div class="cards" id="productGrid">${products.map(productCard).join('')}</div></section>`}
   20: function qualityBlock(full=true){return `<section class="section" id="quality-section"><div class="section-head"><div><div class="eyebrow">Quality & Analysis</div><h2>${full?'Quality & Analysis':'Quality System'}</h2></div><p>Dokumentationsstruktur fÇ¬r Batch, COA, Labor, Datum, IdentitÇÏt, Reinheit, Methode, Report und QR-Zugriff.</p></div><div class="quality-grid"><ol class="process"><li><div><strong>Product Coding</strong><p class="compound-meta">Jedes Produkt erhÇÏlt ein konsistentes Code- und Konzentrationsschema.</p></div></li><li><div><strong>Batch Assignment</strong><p class="compound-meta">Charge und Produktcode sind im Label, Katalog und Batch-Lookup identisch.</p></div></li><li><div><strong>External Analysis Fields</strong><p class="compound-meta">COA-, Labor-, Methodik- und IdentitÇÏtsfelder sind angelegt, aber nicht erfunden.</p></div></li><li><div><strong>Report Access</strong><p class="compound-meta">QR und Batch-Seiten fÇ¬hren zum jeweiligen PrÇ¬fbericht, sobald dieser vorliegt.</p></div></li><li><div><strong>Traceability</strong><p class="compound-meta">Jede Charge ist Ç¬ber Produkt, Code und Batch-ID eindeutig zurÇ¬ckverfolgbar.</p></div></li></ol><div class="coa-preview">${report(products[10])}<div class="cta-row"><a class="primary-btn" href="#batch-lookup">Batch prÇ¬fen</a><a class="secondary-btn" href="#product=5-amino-1mq">Produktdetail ansehen</a></div></div></div></section>`}
   21: function qualityPage(){return `${qualityBlock(true)}<section class="section"><div class="section-head"><div><div class="eyebrow">Analysis Library</div><h2>13/13 dokumentierte Report-ZugÇÏnge.</h2></div><p>Alle EintrÇÏge sind strukturell angelegt; keine nicht vorhandenen Laborergebnisse werden angezeigt.</p></div><div class="cards">${products.map(p=>`<article class="product-card" style="min-height:330px"><div class="card-top"><span>${p.code}</span><span>${p.batch}</span></div><h3>${p.name}</h3><p class="compound-meta">${p.concentration}</p><div class="price-row"><span class="status">Report Access</span><a href="#product=${p.id}" class="secondary-btn">Ç-ffnen</a></div></article>`).join('')}</div></section>`}
   22: function batchPage(batch=''){const p=pByBatch(batch);return `<section class="section"><div class="section-head"><div><div class="eyebrow">Batch Lookup</div><h1 class="page-title">Batchnummer <span>prÇ¬fen.</span></h1></div><p>Produkt, Konzentration, Code und vorbereitete Analysefelder werden Ç¬ber die Batch-ID verbunden.</p></div><div class="batch-panel"><input id="batchInput" value="${batch||''}" placeholder="z. B. EL-BPC5-26001"><div class="cta-row"><button class="primary-btn" id="batchBtn">Batch prÇ¬fen</button><button class="secondary-btn" id="sampleBatch">Erste Batch-ID einsetzen</button></div><div id="batchResult" style="margin-top:22px">${p?batchResult(p):batchHint()}</div></div></section>`}
   23: function batchHint(){return `<p class="compound-meta">Akzeptierte Start-Batches: ${products.slice(0,4).map(p=>p.batch).join(' ¶ú ')} ¶ú weitere im Katalog.</p>`}
   24: function batchResult(p){return `<div class="detail-layout" style="padding:0;border:0;background:transparent"><div><img class="qr" src="${p.qr}" alt="QR zu ${p.batch}"><div class="product-img-wrap" style="max-width:260px;margin-top:16px"><img src="${p.image}" alt="${p.name} Vial"></div></div><div><div class="eyebrow">Batch Result</div><h2>${p.name}</h2><p>${p.concentration} ¶ú ${p.code} ¶ú ${p.batch}</p><div class="report-grid"><div><span>COA</span><strong>Nicht verÇôffentlicht</strong></div><div><span>Lab</span><strong>Nicht verÇôffentlicht</strong></div><div><span>Identity</span><strong>Ausstehend</strong></div><div><span>Report</span><strong>Access vorbereitet</strong></div></div><div class="cta-row"><a class="primary-btn" href="#product=${p.id}">Produktdetail</a><a class="secondary-btn" href="#quality">Analysis Library</a></div></div></div>`}
   25: function productDetail(id){const p=pById(id)||products[0];return `<section class="section"><a href="#products" class="secondary-btn">ƒÅ? ZurÇ¬ck zum Katalog</a><div class="detail-layout" style="margin-top:22px"><div class="gallery"><div class="gallery-main"><img src="${p.detailImage}" alt="${p.name} Elements Labs Produktbild"></div><div class="thumbs"><img src="${p.image}" alt="${p.name} Vial"><img src="${p.packagingImage}" alt="Elements Labs Packaging"><img src="${p.macroImage}" alt="Elements Labs Macro Detail"></div></div><aside class="purchase"><div class="eyebrow">${p.num} ¶ú ${p.category}</div><h1>${p.name}</h1><p class="lead">${p.desc}</p><div class="price" style="margin:10px 0 18px">${p.price}</div><div class="spec-list"><div><span>Konzentration</span><strong>${p.concentration}</strong></div><div><span>Einheit</span><strong>1 Vial</strong></div><div><span>Product Code</span><strong>${p.code}</strong></div><div><span>Batch</span><strong>${p.batch}</strong></div></div><p class="compound-meta"><strong>Research Notice:</strong> Not for human consumption. No therapeutic, diagnostic, veterinary or dosing claims.</p><div class="cta-row"><button class="primary-btn" data-add="${p.id}">Add to Cart</button><a class="secondary-btn" href="#batch=${p.batch}">Batch anzeigen</a></div></aside></div></section><section class="section"><div class="section-head"><div><div class="eyebrow">Product Documentation</div><h2>Research Information & Specifications</h2></div><p>Produktdaten bleiben exakt; Analysewerte werden erst nach echter PrÇ¬fung ergÇÏnzt.</p></div>${report(p)}</section>`}
   26: function cartPage(){const items=Object.entries(cart).map(([id,qty])=>({p:pById(id),qty})).filter(x=>x.p);const total=items.reduce((s,x)=>s+money(x.p.price)*x.qty,0);return `<section class="section"><div class="section-head"><div><div class="eyebrow">Cart</div><h1 class="page-title">Warenkorb <span>prÇ¬fen.</span></h1></div><p>Produktauswahl, Mengen und Summen im Çoberblick. Bestellanfragen werden individuell von Elements Labs bearbeitet.</p></div><div class="cart-panel">${items.length?items.map(x=>`<div class="cart-line"><strong>${x.p.name}<br><span class="compound-meta">${x.p.concentration} ¶ú ${x.p.batch}</span></strong><span>${x.p.price}</span><div class="qty"><button data-qty="${x.p.id}" data-delta="-1">ƒ^'</button><span>${x.qty}</span><button data-qty="${x.p.id}" data-delta="1">+</button></div><button class="ghost-btn" data-remove="${x.p.id}">Remove</button></div>`).join(''):'<p class="compound-meta">Der Warenkorb ist leer.</p>'}<p class="compound-meta">Anzeige inklusive Umsatzsteuer.</p><div class="total" id="cartTotal">${fmt(total)}</div><div class="cta-row"><button class="primary-btn" id="checkoutBtn">Bestellanfrage senden</button><a class="secondary-btn" href="#products">Weiter einkaufen</a></div><div id="checkoutDemo" class="hidden" style="margin-top:20px"><span class="internal-badge">Anfrage erfasst</span><p>Elements Labs bearbeitet Bestellanfragen individuell ƒ?" Sie erhalten eine RÇ¬ckmeldung mit VerfÇ¬gbarkeit und Versandoptionen.</p></div></div></section>`}
   27: function about(){return `<section class="section legal"><div class="eyebrow">About</div><h1 class="page-title">European Research Commerce, <span>prÇÏzise gefÇ¬hrt.</span></h1><p class="lead">ELEMENTS LABS positioniert Research-Produkte Ç¬ber Materialklarheit, dokumentierte Batch-Struktur und zurÇ¬ckhaltendes Premium-Design.</p><p>Die Marke vermeidet Fitness-, Supplement- und Pharma-Anmutung. Der Fokus liegt auf reproduzierbaren Produktvisuals, systematischer Informationsarchitektur und einem ehrlichen Analyse-Framework.</p></section>`}
   28: function faq(){return `<section class="section legal"><div class="eyebrow">FAQ</div><h1 class="page-title">Research-only <span>clarity.</span></h1><div class="faq-list"><details open><summary>Sind Bestellungen bereits aktiv?</summary><p>Bestellanfragen werden bereits entgegengenommen und individuell bestÇÏtigt. Zahlungsabwicklung und Versand werden je Anfrage abgestimmt.</p></details><details><summary>Sind Laborberichte verÇôffentlicht?</summary><p>Nein. Die Website zeigt die Struktur. Echte Analysewerte werden erst nach externer PrÇ¬fung ergÇÏnzt.</p></details><details><summary>Gibt es medizinische Aussagen?</summary><p>Nein. Keine Einnahme-, Dosierungs-, Therapie-, Diagnose- oder Human-Use-Anleitung.</p></details><details><summary>Warum Batch Lookup?</summary><p>Das System verbindet Produkt, Charge und spÇÏteren Berichtszugriff nachvollziehbar.</p></details></div></section>`}
   29: function contact(){return `<section class="section legal"><div class="eyebrow">Support</div><h1 class="page-title">Kontakt <span>Elements Labs.</span></h1><p class="lead">FÇ¬r Bestellanfragen, Fachfragen und Kooperationen erreichen Sie Elements Labs direkt.</p><div class="batch-panel"><p><strong>ELEMENTS LABS</strong><br>Research-only commerce structure<br>Germany / EU market focus</p><p class="compound-meta">Keine medizinische Beratung. Keine Human-Use-Kommunikation.</p></div></section>`}
   30: function legal(kind){return `<section class="section legal"><div class="eyebrow">Legal</div><h1 class="page-title">${kind==='privacy'?'Datenschutz':'Impressum'}</h1><p>Betreiber-, Rechts- und Datenschutzangaben nach deutschem Recht.</p><p>Research-use-only. No human consumption. No medical, therapeutic, diagnostic or veterinary claims.</p></section>`}
