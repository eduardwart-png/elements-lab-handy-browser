 389: FONTS_DIR = ASSETS / 'fonts'
 390: FONT_WEIGHTS = [
 391:     ('space-grotesk-0.woff2', 400, 'normal'),
 392:     ('space-grotesk-1.woff2', 500, 'normal'),
 393:     ('space-grotesk-2.woff2', 600, 'normal'),
 394:     ('space-grotesk-3.woff2', 700, 'normal'),
 395: ]
 396: 
 397: 
 398: def font_face_css(inline: bool) -> str:
 399:     faces = []
 400:     for fname, weight, style in FONT_WEIGHTS:
 401:         fpath = FONTS_DIR / fname
 402:         if not fpath.exists():
 403:             continue
 404:         src = data_url(fpath) if inline else f'assets/fonts/{fname}'
 405:         faces.append(
 406:             f"@font-face{{font-family:'Space Grotesk';font-style:{style};font-weight:{weight};"
 407:             f"font-display:swap;src:url('{src}') format('woff2')}}"
 408:         )
 409:     return ''.join(faces)
