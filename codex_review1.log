 129:         w, h = 520, 150; mark_x, mark_y, s = 34, 30, 70; text = '<text x="158" y="68" font-family="Segoe UI, Arial, sans-serif" font-size="42" font-weight="800" letter-spacing="8" fill="%s">ELEMENTS</text><text x="158" y="112" font-family="Segoe UI, Arial, sans-serif" font-size="42" font-weight="800" letter-spacing="8" fill="%s">LABS</text>' % (ink, ink)
 130:     svg = f'''<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {w} {h}" width="{w}" height="{h}">
 131: <rect width="100%" height="100%" fill="{bg}"/>
 132: <g transform="translate({mark_x} {mark_y})">
 133: <rect x="0" y="0" width="16" height="{s}" rx="2" fill="{mark_e}"/>
 134: <rect x="0" y="0" width="50" height="16" rx="2" fill="{mark_e}"/>
 135: <rect x="0" y="{s*0.41:.1f}" width="43" height="16" rx="2" fill="{mark_e}"/>
 136: <rect x="0" y="{s-16}" width="50" height="16" rx="2" fill="{mark_e}"/>
 137: <rect x="{s*0.66:.1f}" y="0" width="16" height="{s}" rx="2" fill="{mark_l}"/>
 138: <rect x="{s*0.66:.1f}" y="{s-16}" width="50" height="16" rx="2" fill="{mark_l}"/>
 139: </g>{text}
 140: </svg>'''
 141:     return svg
