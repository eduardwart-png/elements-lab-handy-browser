 545: def standalone_products():
 546:     data = []
 547:     for p in PRODUCTS:
 548:         q = dict(p)
 549:         for key in ['image','detailImage','macroImage','packagingImage','qr']:
 550:             q[key] = data_url(ROOT / q[key])
 551:         data.append(q)
 552:     return data
