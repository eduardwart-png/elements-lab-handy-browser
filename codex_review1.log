 487: if bad: fail.append('relative html dependency remains '+json.dumps(bad[:10]))
 488: products = json.loads(re.search(r'<script id="productData" type="application/json">(.*?)</script>', html, re.S).group(1))
 489: if len(products)!=13: fail.append('product data count !=13')
 490: for key in ['name','concentration','price','batch','code','image','detailImage','qr']:
 491:     if any(not p.get(key) for p in products): fail.append('missing '+key)
 492: for p in products:
