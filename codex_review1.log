 178: def paste_qr(base: Image.Image, product, box):
 179:     qr_path = ROOT / product['qr']
 180:     if not qr_path.exists():
 181:         return
 182:     qr = Image.open(qr_path).convert('RGBA').resize((box[2]-box[0], box[3]-box[1]), Image.Resampling.LANCZOS)
 183:     base.alpha_composite(qr, (box[0], box[1]))
