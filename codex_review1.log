px;background:linear-gradient(90deg,var(--graphite),var(--petrol));opacity:.95}.card-top{display:flex;justify-content:space-between;font:800 10px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin:8px 0 8px}.product-img-wrap{display:grid;place-items:center;background:linear-gradient(180deg,#F8FAFA,#ECEFF1);border:1px solid #E1E6E8;border-radius:23px;min-height:250px;margin-bottom:18px;overflow:hidden}.product-img-wrap img{width:82%;height:auto;filter:drop-shadow(0 18px 24px rgba(13,17,21,.14))}.product-card h3{margin:0 0 7px;font-size:22px;letter-spacing:-.018em;color:var(--near-black)}.compound-meta{font-size:13px;color:var(--muted);line-height:1.58}.price-row{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:17px}.price{font:850 24px/1 var(--sans);letter-spacing:-.02em}.status{font:800 11px var(--mono);color:var(--petrol);text-transform:uppercase;letter-spacing:.07em}.card-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}.card-actions .secondary-btn,.card-actions .primary-btn{text-align:center;padding:12px 10px;font-size:13px}.quality-grid{display:grid;grid-template-columns:.92fr 1.08fr;gap:28px;align-items:start}.process{counter-reset:step;list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:14px}.process li{counter-increment:step;position:relative;padding:18px 18px 18px 58px;background:#fff;border:1px solid var(--line);border-radius:18px}.process li:before{content:counter(step,decimal-leading-zero);position:absolute;left:17px;top:20px;font:850 14px var(--mono);color:var(--petrol)}.process strong{display:block;margin-bottom:4px}.coa-preview,.batch-panel,.cart-panel,.partner-panel{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;box-shadow:0 15px 42px rgba(13,17,21,.07)}.report{position:relative;background:#FCFCFD;color:var(--near-black);border:1px solid #DDE2E5;border-radius:18px;padding:24px}.report-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:18px}.report-grid div{padding:12px;border:1px solid #E1E5E8;border-radius:12px;background:white}.report-grid span{display:block;font:800 10px var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}.report-grid strong{font-size:14px}.detail-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:36px;align-items:start}.gallery{display:grid;gap:16px}.gallery-main{background:linear-gradient(180deg,#fff,#EEF2F3);border:1px solid var(--line);border-radius:32px;overflow:hidden;box-shadow:var(--shadow)}.gallery-main img{display:block;width:100%;height:auto}.thumbs{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.thumbs img{width:100%;border:1px solid var(--line);border-radius:18px;background:#fff}.purchase{position:sticky;top:100px;background:#fff;border:1px solid var(--line);border-radius:32px;padding:30px;box-shadow:0 20px 46px rgba(13,17,21,.09)}.purchase h1{font-size:clamp(38px,4vw,58px);line-height:1.02;letter-spacing:-.04em;margin:0 0 15px;color:var(--near-black)}.spec-list{display:grid;grid-template-columns:1fr 1fr;gap:13px;margin:24px 0}.spec-list div{padding:14px;background:#F6F8F8;border:1px solid var(--line);border-radius:14px}.spec-list span{display:block;font:800 10px var(--mono);color:var(--muted);text-transform:uppercase;letter-spacing:.08em;margin-bottom:4px}.spec-list strong{font-size:16px}.filters{display:grid;grid-template-columns:1.5fr .8fr .8fr;gap:12px;margin-bottom:24px}.filters input,.filters select,.batch-panel input{padding:13px 15px;background:#fff;border:1px solid var(--line);border-radius:14px;color:var(--ink)}.batch-panel input{width:100%;margin-bottom:16px}.qr{width:128px;height:128px;border-radius:12px;background:#fff;padding:7px;display:block;margin-top:18px;border:1px solid var(--line)}.cart-line{display:grid;grid-template-columns:1.2fr .7fr .7fr auto;gap:16px;align-items:center;padding:18px 0;border-bottom:1px solid var(--line)}.qty{display:flex;gap:7px;align-items:center}.qty button{width:32px;height:32px;border-radius:50%;border:1px solid var(--line);background:#fff}.total{font:850 30px/1 var(--sans);text-align:right;margin:22px 0}.hidden{display:none}.footer{max-width:var(--max);margin:0 auto;padding:62px 22px 44px;display:grid;grid-template-columns:2fr 1.3fr 1.2fr;gap:28px;color:var(--muted);font-size:13px;border-top:1px solid var(--line)}.footer strong{color:var(--near-black)}.footer a{display:block;color:var(--muted);margin-bottom:8px}.research-only{grid-column:1/-1;text-align:center;font:800 11px var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--muted);padding-top:18px;border-top:1px solid var(--line)}.faq-list{display:flex;flex-direction:column;gap:14px}.faq-list details{background:#fff;border:1px solid var(--line);border-radius:18px;padding:17px}.faq-list summary{font-weight:750;cursor:pointer}.legal{max-width:820px}.family-section .wide-photo{margin-top:10px}.brand-story{display:grid;grid-template-columns:.9fr 1.1fr;gap:32px;align-items:center}.brand-story img{width:100%;border-radius:30px;border:1px solid var(--line);box-shadow:var(--shadow)}.internal-badge{display:inline-block;background:#F2C94C;color:#101418;font:850 11px var(--mono);letter-spacing:.06em;text-transform:uppercase;padding:6px 12px;border-radius:8px}.partner-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}.kpi{padding:20px;background:#F6F8F8;border:1px solid var(--line);border-radius:16px}.kpi span{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}.kpi strong{display:block;font-size:26px;margin:8px 0 4px}.partner-table{width:100%;border-collapse:collapse;font-size:14px}.partner-table th,.partner-table td{padding:12px 10px;text-align:left;border-bottom:1px solid var(--line)}.partner-table th{font:800 11px var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}#toast{position:fixed;bottom:22px;right:22px;z-index:60;background:var(--near-black);color:white;border:1px solid rgba(255,255,255,.12);border-radius:13px;padding:12px 18px;font-size:13px;box-shadow:var(--shadow);opacity:0;transform:translateY(10px);transition:opacity .25s,transform .25s;pointer-events:none}#toast.show-toast{opacity:1;transform:translateY(0)}
C:\Users\eduar\elements-lab-flagship\build_elements_site.py:438: function report(p){return `<div class="report" data-coa="${p.id}"><div class="eyebrow">Analysis structure</div><h3>Batch Documentation - ${p.name}</h3><p class="compound-meta">Dieses Panel bildet die sp„tere Berichtstruktur ab. Werte werden erst nach echter externer Analyse ver”ffentlicht.</p><div class="report-grid"><div><span>Compound</span><strong>${p.name}</strong></div><div><span>Batch</span><strong>${p.batch}</strong></div><div><span>COA</span><strong>Nicht ver”ffentlicht</strong></div><div><span>Lab</span><strong>Nicht ver”ffentlicht</strong></div><div><span>Date</span><strong>Nicht ver”ffentlicht</strong></div><div><span>Identity</span><strong>Ausstehend</strong></div><div><span>Purity</span><strong>Ausstehend</strong></div><div><span>Method</span><strong>Ausstehend</strong></div></div></div>`}
C:\Users\eduar\elements-lab-flagship\build_elements_site.py:439: function home(){const featured=products.filter(p=>p.featured).slice(0,6);return `<section class="section hero" id="home-hero"><div><div class="eyebrow">European Premium Research Brand</div><h1>ELEMENTS LABS. <span>Research Commerce</span> mit realer Produktdisziplin.</h1><p class="lead">Eine helle, technische Premium-Marke fr strukturierte Research-Ware: klare Vials, konsistente Verpackung, Batch-Traceability und Commerce ohne medizinische Claims.</p><div class="cta-row"><a class="primary-btn" href="#products">Produkte entdecken</a><a class="secondary-btn" href="#batch-lookup">Batch prfen</a></div><div class="trust-matrix"><div><strong>13 Produkte</strong><span>vollst„ndiges Startportfolio</span></div><div><strong>Ein Labelsystem</strong><span>einheitliche Verpackungslinie</span></div><div><strong>Batch-Struktur</strong><span>Produkt, Code und Charge verbunden</span></div><div><strong>Research Only</strong><span>keine Human-Use-Kommunikation</span></div></div></div><figure class="hero-photo"><img src="assets/scenes/hero-studio-scene.png" alt="ELEMENTS LABS Produktfotografie mit Vials und Verpackung"><figcaption class="photo-caption">macro studio ú graphite / off-white / petrol</figcaption></figure></section><section class="section"><div class="section-head"><div><div class="eyebrow">Featured Products</div><h2>Portfolio mit einheitlicher Produktlogik.</h2></div><p>Jede Karte nutzt dieselbe Glasform, dasselbe Labelraster und dieselbe Informationshierarchie.</p></div><div class="cards">${featured.map(productCard).join('')}</div></section>${qualityBlock(false)}<section class="section family-section"><div class="section-head"><div><div class="eyebrow">Product Family</div><h2>13 Produkte, eine glaubwrdige Fertigungslinie.</h2></div><p>Keine zuf„lligen Farben, keine Clipart-Logos, keine wechselnden Glasformen: Die Vials wirken wie eine zusammenh„ngende Markenproduktion.</p></div><figure class="wide-photo"><img src="assets/scenes/group-product-shot.png" alt="ELEMENTS LABS Gruppe mit 13 Research Vials"><figcaption class="photo-caption">13/13 product family</figcaption></figure></section><section class="section brand-story"><div><div class="eyebrow">Packaging Direction</div><h2>Off-White Karton, Graphite-Typografie, Petrol-Akzent.</h2><p class="lead">Die Verpackung ist bewusst n„her an Diagnostics, Labortechnik und Premium-Kosmetik als an Supplements oder Fitness-Commerce.</p><div class="cta-row"><a class="primary-btn" href="#quality">Quality System</a><a class="secondary-btn" href="#about">Brand Story</a></div></div><img src="assets/scenes/packaging-shot.png" alt="ELEMENTS LABS Premium Packaging mit Vial"></section><section class="section"><div class="section-head"><div><div class="eyebrow">FAQ / Support</div><h2>Klarheit vor Conversion-Hype.</h2></div><p>Die Seite bleibt commercef„hig, ohne Laborwerte, Zertifikate oder Unternehmensdetails zu erfinden.</p></div><div class="faq-list"><details open><summary>Wofr ist das Portfolio vorgesehen?</summary><p>Fr Research-Kontexte. Keine Einnahme, keine Anwendung, keine therapeutische oder diagnostische Kommunikation.</p></details><details><summary>Was zeigt die Batch-Suche?</summary><p>Sie verbindet Produkt, Charge, Code und vorbereitete Analysefelder. Reale Werte werden erst nach echter Prfung erg„nzt.</p></details><details><summary>Warum diese Bildwelt?</summary><p>Makro-Studiofotografie, klare Materialien und ein reproduzierbares Labelsystem machen die Marke glaubwrdig und skalierbar.</p></details></div></section>`}
C:\Users\eduar\elements-lab-flagship\build_elements_site.py:440: function productsPage(){return `<section class="section"><div class="section-head"><div><div class="eyebrow">Catalog</div><h1 class="page-title">13 Research <span>Products.</span></h1></div><p>Alle verbindlichen Produkte mit korrekter Konzentration, Preis, Produktcode und Batch-ID.</p></div><div class="filters"><input id="searchInput" placeholder="Search compound, code or batch" aria-label="Produkt suchen"><select id="categoryFilter"><option value="">Alle Kategorien</option>${[...new Set(products.map(p=>p.category))].map(c=>`<option>${c}</option>`).join('')}</select><select id="sortFilter"><option value="featured">Featured zuerst</option><option value="price-asc">Preis aufsteigend</option><option value="price-desc">Preis absteigend</option></select></div><div class="cards" id="productGrid">${products.map(productCard).join('')}</div></section>`}
C:\Users\eduar\elements-lab-flagship\build_elements_site.py:441: function qualityBlock(full=true){return `<section class="section" id="quality-section"><div class="section-head"><div><div class="eyebrow">Quality & Analysis</div><h2>${full?'Quality & Analysis':'Quality System'}</h2></div><p>Dokumentationsstruktur fr Batch, COA, Labor, Datum, Identit„t, Reinheit, Methode, Report und QR-Zugriff.</p></div><div class="quality-grid"><ol class="process"><li><div><strong>Product Coding</strong><p class="compound-meta">Jedes Produkt erh„lt ein konsistentes Code- und Konzentrationsschema.</p></div></li><li><div><strong>Batch Assignment</strong><p class="compound-meta">Charge und Produktcode sind im Label, Katalog und Batch-Lookup identisch.</p></div></li><li><div><strong>External Analysis Fields</strong><p class="compound-meta">COA-, Labor-, Methodik- und Identit„tsfelder sind angelegt, aber nicht erfunden.</p></div></li><li><div><strong>Report Access</strong><p class="compound-meta">QR und Batch-Seiten fhren zum jeweiligen Prfbericht, sobald dieser vorliegt.</p></div></li><li><div><strong>Traceability</strong><p class="compound-meta">Jede Charge ist ber Produkt, Code und Batch-ID eindeutig zurckverfolgbar.</p></div></li></ol><div class="coa-preview">${report(products[10])}<div class="cta-row"><a class="primary-btn" href="#batch-lookup">Batch prfen</a><a class="secondary-btn" href="#product=5-amino-1mq">Produktdetail ansehen</a></div></div></div></section>`}
C:\Users\eduar\elements-lab-flagship\build_elements_site.py:442: function qualityPage(){return `${qualityBlock(true)}<section class="section"><div class="section-head"><div><div class="eyebrow">Analysis Library</div><h2>13/13 dokumentierte Report-Zug„nge.</h2></div><p>Alle Eintr„ge sind strukturell angelegt; keine nicht vorhandenen Laborergebnisse werden angezeigt.</p></div><div class="cards">${products.map(p=>`<article class="product-card" style="min-height:330px"><div class="card-top"><span>${p.code}</span><span>${p.batch}</span></div><h3>${p.name}</h3><p class="compound-meta">${p.concentration}</p><div class="price-row"><span class="status">Report Access</span><a href="#product=${p.id}" class="secondary-btn">™ffnen</a></div></article>`).join('')}</div></section>`}
C:\Users\eduar\elements-lab-flagship\build_elements_site.py:443: function batchPage(batch=''){const p=pByBatch(batch);return `<section class="section"><div class="section-head"><div><div class="eyebrow">Batch Lookup</div><h1 class="page-title">Batchnummer <span>prfen.</span></h1></div><p>Produkt, Konzentration, Code und vorbereitete Analysefelder werden ber die Batch-ID verbunden.</p></div><div class="batch-panel"><input id="batchInput" value="${batch||''}" placeholder="z. B. EL-BPC5-26001"><div class="cta-row"><button class="primary-btn" id="batchBtn">Batch prfen</button><button class="secondary-btn" id="sampleBatch">Erste Batch-ID einsetzen</button></div><div id="batchResult" style="margin-top:22px">${p?batchResult(p):batchHint()}</div></div></section>`}
C:\Users\eduar\elements-lab-flagship\build_elements_site.py:445: function batchResult(p){return `<div class="detail-layout" style="padding:0;border:0;background:transparent"><div><img class="qr" src="${p.qr}" alt="QR zu ${p.batch}"><div class="product-img-wrap" style="max-width:260px;margin-top:16px"><img src="${p.image}" alt="${p.name} Vial"></div></div><div><div class="eyebrow">Batch Result</div><h2>${p.name}</h2><p>${p.concentration} ú ${p.code} ú ${p.batch}</p><div class="report-grid"><div><span>COA</span><strong>Nicht ver”ffentlicht</strong></div><div><span>Lab</span><strong>Nicht ver”ffentlicht</strong></div><div><span>Identity</span><strong>Ausstehend</strong></div><div><span>Report</span><strong>Access vorbereitet</strong></div></div><div class="cta-row"><a class="primary-btn" href="#product=${p.id}">Produktdetail</a><a class="secondary-btn" href="#quality">Analysis Library</a></div></div></div>`}
