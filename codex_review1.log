 478: import json, re, sys
 479: root = Path(sys.argv[1])
 480: html = (root / '_standalone.html').read_text(encoding='utf-8')
 481: fail=[]
 482: if re.search(r'<script\s+[^>]*src=', html, re.I): fail.append('script src remains')
 483: if re.search(r'<link\s+[^>]*stylesheet', html, re.I): fail.append('stylesheet link remains')
